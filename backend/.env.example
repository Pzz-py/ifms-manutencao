# Banco de dados (SQLite - arquivo local, apenas para o protótipo)
DATABASE_URL="file:./dev.db"

# Porta em que a API vai rodar
PORT=3333

# Ambiente de execução
NODE_ENV=development

# URL do frontend, usada na configuração de CORS
FRONTEND_URL="http://localhost:5173"

# Segredo usado para assinar os tokens JWT (troque por um valor forte)
JWT_SECRET="troque-este-valor-por-um-segredo-forte"
JWT_EXPIRES_IN="7d"

# Pasta onde os anexos (imagens dos chamados) serão salvos
UPLOADS_DIR="uploads"
