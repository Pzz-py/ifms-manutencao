# Variáveis usadas pelo docker-compose.yml. Copie este arquivo para
# ".env" (mesma pasta do docker-compose.yml) e ajuste se quiser.
#
#   cp .env.example .env
#
# Todas têm um valor padrão no próprio docker-compose.yml, então rodar
# sem esse arquivo também funciona — mas troque o JWT_SECRET antes de
# expor o sistema além do seu próprio computador.

# Porta em que o frontend fica acessível no seu navegador.
FRONTEND_PORT=5173

# Porta em que a API fica acessível (útil para testar com Postman/Insomnia).
BACKEND_PORT=3333

# Segredo usado para assinar os tokens JWT — troque por um valor forte.
JWT_SECRET=troque-este-valor-por-um-segredo-forte

JWT_EXPIRES_IN=7d
